# Normalize all text files to LF in the repo and in the working tree.
* text=auto eol=lf

# Explicit LF for the file types that matter here
*.c        text eol=lf
*.h        text eol=lf
*.s        text eol=lf
*.S        text eol=lf
*.cpp      text eol=lf
*.hpp      text eol=lf
*.ld       text eol=lf
*.sct      text eol=lf
*.icf      text eol=lf
*.mk       text eol=lf
Makefile   text eol=lf
*.cmake    text eol=lf
*.txt      text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.xml      text eol=lf
*.ioc      text eol=lf
*.sh       text eol=lf
*.bat      text eol=lf
*.ps1      text eol=lf
*.py       text eol=lf
.gitignore  text eol=lf
.gitmodules text eol=lf
.gitattributes text eol=lf

# Binaries: never diff, never convert
*.pdf    binary
*.bin    binary
*.hex    binary
*.elf    binary
*.axf    binary
*.a      binary
*.lib    binary
*.o      binary
*.obj    binary
*.zip    binary
*.7z     binary
*.rar    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.bmp    binary
*.ttf    binary
*.woff   binary
*.woff2  binary
